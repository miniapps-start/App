<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>Демо «Старт» — Nail Room</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Prata&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
/* ===== Фирменные цвета демо-салона ===== */
:root{--bg:#fbf6f4;--card:#ffffff;--ink:#2b1d26;--mut:#8a7480;--line:#efe2e4;--acc:#8e3b5f;--acc2:#e8b4c3;--soft:#f6e7ec;
--disp:"Prata",Georgia,serif;--sans:"Nunito",-apple-system,"Segoe UI",Roboto,sans-serif}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;background:var(--bg)}
body{font:400 15px/1.5 var(--sans);color:var(--ink);overflow:hidden}
#app{position:fixed;inset:0;overflow-y:auto;overflow-x:hidden;padding-bottom:96px}
/* полоса «демо-режим» — одинаковая во всех демо */
.demo{position:sticky;top:0;z-index:9;display:flex;align-items:center;gap:10px;padding:9px 14px;background:#111;color:#f1d9a0;font:600 12px/1.3 var(--sans)}
.demo a{color:#f1d9a0;text-decoration:none;border:1px solid rgba(241,217,160,.4);border-radius:10px;padding:5px 9px;white-space:nowrap}
.demo span{flex:1;opacity:.85}
.wrap{max-width:480px;margin:auto;padding:0 18px}
.page{display:none;padding:22px 0}.page.on{display:block;animation:in .3s ease}
@keyframes in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
h1{font:400 32px/1.1 var(--disp);margin-bottom:8px}
h2{font:400 24px/1.15 var(--disp);margin:6px 0 14px}
p{color:var(--mut)}
.hero{border-radius:24px;padding:26px 22px;background:linear-gradient(150deg,#f3d6df,#fbeef2 60%,#fff);border:1px solid var(--line);margin-bottom:18px;position:relative;overflow:hidden}
.hero:after{content:"";position:absolute;right:-30px;top:-30px;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,var(--acc2),transparent 70%);opacity:.7}
.hero>*{position:relative}
.tag{display:inline-block;font:700 11px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--acc);background:#fff;border-radius:20px;padding:4px 10px;margin-bottom:12px}
.btn{display:flex;align-items:center;justify-content:center;width:100%;border:0;border-radius:16px;padding:15px;font:700 15px var(--sans);cursor:pointer;background:var(--acc);color:#fff;margin-top:16px}
.btn.ghost{background:var(--card);color:var(--acc);border:1px solid var(--line)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mini{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px}
.mini b{display:block;font-size:20px;color:var(--acc)}
.mini span{font-size:13px;color:var(--mut)}
.cat{font:800 12px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:18px 0 8px}
.svc{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px;margin-bottom:10px}
.svc div{flex:1;min-width:0}.svc b{display:block}.svc small{color:var(--mut)}
.svc em{font-style:normal;font-weight:800;color:var(--acc);white-space:nowrap}
.svc button{border:1px solid var(--acc2);background:var(--soft);color:var(--acc);border-radius:12px;padding:8px 10px;font:700 12px var(--sans);cursor:pointer}
.gal{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.ph{aspect-ratio:3/4;max-width:100%;border-radius:18px;display:flex;align-items:flex-end;padding:10px;color:#fff;font:700 12px var(--sans);text-shadow:0 1px 4px rgba(0,0,0,.35)}
.ct{display:flex;flex-direction:column;gap:10px}
.ct a,.ct div{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:15px;color:var(--ink);text-decoration:none}
.ct i{width:36px;height:36px;border-radius:12px;background:var(--soft);display:grid;place-items:center;font-style:normal;color:var(--acc);font-weight:800}
label{display:block;font:700 13px var(--sans);color:var(--mut);margin:14px 0 6px}
input,select,textarea{width:100%;padding:13px 14px;border-radius:14px;border:1px solid var(--line);background:#fff;color:var(--ink);font:15px var(--sans);outline:0}
input:focus,select:focus,textarea:focus{border-color:var(--acc)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.err{color:#c0392b;font-size:13px;margin-top:8px;min-height:18px}
/* показ «что видит мастер» */
.how{margin-top:18px;border-radius:20px;padding:16px;background:#1d1a22;color:#eee}
.how h3{font:800 12px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:#f1d9a0;margin-bottom:10px}
.bub{background:#2b2733;border-radius:16px 16px 16px 4px;padding:12px 14px;font-size:14px;line-height:1.5;margin-bottom:8px}
.bub.me{background:#3d5a80;border-radius:16px 16px 4px 16px;margin-left:30px}
.bub small{display:block;color:#9aa;font-size:11px;margin-top:4px}
.note{font-size:12px;color:#aaa;margin-top:8px}
nav{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));max-width:480px;margin:auto;display:flex;padding:6px;background:rgba(255,255,255,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:22px;box-shadow:0 10px 30px rgba(80,30,50,.12);z-index:8}
nav button{flex:1;border:0;background:none;color:var(--mut);font:700 11px var(--sans);padding:8px 2px;border-radius:16px;cursor:pointer}
nav button.on{background:var(--soft);color:var(--acc)}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style></head><body>
<div id="app">
 <div class="demo"><a href="index.html#cases">← Назад</a><span>Демо «Старт» · заявки никуда не отправляются</span></div>
 <div class="wrap">

 <!-- 1. Главная -->
 <section class="page on" id="home">
  <div class="hero">
   <span class="tag">Ереван · Кентрон</span>
   <h1>Nail Room</h1>
   <p>Аккуратный маникюр и педикюр в спокойной студии. Стерильные инструменты, покрытие держится до 3 недель.</p>
   <button class="btn" data-go="apply">Записаться</button>
  </div>
  <div class="row">
   <div class="mini"><b>7 лет</b><span>опыта мастера</span></div>
   <div class="mini"><b>3 недели</b><span>держится покрытие</span></div>
   <div class="mini"><b>10:00–21:00</b><span>без выходных</span></div>
   <div class="mini"><b>от 6 000 ֏</b><span>маникюр</span></div>
  </div>
  <button class="btn ghost" data-go="services">Смотреть услуги и цены</button>
 </section>

 <!-- 2. Услуги -->
 <section class="page" id="services">
  <h2>Услуги и цены</h2>
  <div id="svcList"></div>
 </section>

 <!-- 3. Работы -->
 <section class="page" id="works">
  <h2>Наши работы</h2>
  <div class="gal" id="gal"></div>
  <p style="margin-top:12px;font-size:13px">В настоящем приложении здесь фотографии ваших работ.</p>
 </section>

 <!-- 4. Контакты -->
 <section class="page" id="contacts">
  <h2>Контакты</h2>
  <div class="ct">
   <a href="#" onclick="return false"><i>TG</i>Написать в Telegram</a>
   <a href="#" onclick="return false"><i>WA</i>Написать в WhatsApp</a>
   <div><i>⌖</i>ул. Абовяна, 12 · 2 этаж</div>
   <div><i>◷</i>Ежедневно 10:00–21:00</div>
  </div>
  <div class="how">
   <h3>Чат с клиентами</h3>
   <div class="bub">Здравствуйте! Есть окно в субботу после обеда?<small>Клиент пишет в бот</small></div>
   <div class="bub me">Добрый день! Да, в 15:00 свободно, записать вас?<small>Мастер отвечает из панели администратора от имени бота</small></div>
  </div>
 </section>

 <!-- Заявка (открывается кнопками) -->
 <section class="page" id="apply">
  <div id="formBox">
   <h2>Запись</h2>
   <label for="f_name">Имя</label><input id="f_name" placeholder="Анна">
   <label for="f_phone">Телефон</label><input id="f_phone" placeholder="+374 …" inputmode="tel">
   <label for="f_svc">Услуга</label><select id="f_svc"></select>
   <div class="two">
    <div><label for="f_date">Дата</label><input id="f_date" type="date"></div>
    <div><label for="f_time">Время</label><input id="f_time" type="time" value="15:00"></div>
   </div>
   <label for="f_note">Комментарий</label><textarea id="f_note" rows="2" placeholder="Например: хочу нюдовый оттенок"></textarea>
   <button class="btn" id="send">Отправить заявку</button>
   <div class="err" id="err"></div>
  </div>
  <div id="done" hidden>
   <h2>Заявка отправлена</h2>
   <p>Мастер свяжется с вами, чтобы подтвердить время.</p>
   <div class="how">
    <h3>Так мастер получает заявку в Telegram</h3>
    <div class="bub" id="notif"></div>
    <p class="note">В «Старте» мастер подтверждает время сам, в переписке. Кнопка «Подтвердить запись» есть в «Стандарте».</p>
   </div>
   <button class="btn ghost" id="again">Оставить ещё одну заявку</button>
  </div>
 </section>

 </div>
</div>

<nav>
 <button class="on" data-go="home">Главная</button>
 <button data-go="services">Услуги</button>
 <button data-go="works">Работы</button>
 <button data-go="contacts">Контакты</button>
</nav>

<script>
// ===== Данные демо =====
const SERVICES=[
 {cat:"Маникюр",items:[["Классический маникюр","45 мин","6 000 ֏"],["Аппаратный маникюр","50 мин","7 000 ֏"],["Маникюр + гель-лак","1 ч 30 мин","9 000 ֏"]]},
 {cat:"Педикюр",items:[["Педикюр с покрытием","1 ч 40 мин","12 000 ֏"],["SMART-педикюр","1 ч","9 000 ֏"]]},
 {cat:"Дизайн",items:[["Френч","+20 мин","1 500 ֏"],["Дизайн 2 ногтя","+15 мин","1 000 ֏"]]}
];
const WORKS=[["Нюд + блёстки","#e9c2b8,#c98b84"],["Френч","#f6e9e4,#d9b7b0"],["Бордо","#7b1e3a,#3e0d1d"],["Молочный","#f4ece6,#d8c8bd"],["Хром","#c9ccd6,#7c8193"],["Розовый градиент","#f5b8cb,#e07fa0"]];

const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const tg=window.Telegram&&Telegram.WebApp;
if(tg){tg.ready();tg.expand();try{tg.BackButton.show();tg.BackButton.onClick(()=>location.href="index.html#cases")}catch(e){}}

// каталог
$("#svcList").innerHTML=SERVICES.map(g=>`<div class="cat">${g.cat}</div>`+g.items.map(i=>
 `<div class="svc"><div><b>${i[0]}</b><small>${i[1]}</small></div><em>${i[2]}</em><button data-svc="${i[0]}">Выбрать</button></div>`).join("")).join("");
$("#f_svc").innerHTML=SERVICES.flatMap(g=>g.items.map(i=>`<option>${i[0]}</option>`)).join("");
// работы: в демо вместо фото — цветные плашки
$("#gal").innerHTML=WORKS.map(w=>`<div class="ph" style="background:linear-gradient(160deg,${w[1]})">${w[0]}</div>`).join("");
// дата по умолчанию — завтра
const t=new Date(Date.now()+864e5);$("#f_date").value=t.toISOString().slice(0,10);

function go(id){$$(".page").forEach(p=>p.classList.toggle("on",p.id===id));
 $$("nav button").forEach(b=>b.classList.toggle("on",b.dataset.go===id));$("#app").scrollTo(0,0)}
document.addEventListener("click",e=>{
 const g=e.target.closest("[data-go]");if(g)go(g.dataset.go);
 const s=e.target.closest("[data-svc]");if(s){$("#f_svc").value=s.dataset.svc;go("apply")}
});
const ru=d=>{const[y,m,dd]=d.split("-");return dd+"."+m+"."+y.slice(2)};
$("#send").onclick=()=>{
 const n=$("#f_name").value.trim(),ph=$("#f_phone").value.trim();
 if(!n||!ph){$("#err").textContent="Заполните имя и телефон";return}
 $("#err").textContent="";
 $("#notif").innerHTML=`🆕 <b>Новая заявка</b><br>Клиент: ${n}<br>Телефон: ${ph}<br>Услуга: ${$("#f_svc").value}<br>Дата: ${ru($("#f_date").value)}<br>Время: ${$("#f_time").value}${$("#f_note").value.trim()?"<br>Комментарий: "+$("#f_note").value.trim():""}<small>Сообщение от бота мастеру</small>`;
 $("#formBox").hidden=true;$("#done").hidden=false;
 if(tg&&tg.HapticFeedback)tg.HapticFeedback.notificationOccurred("success");
};
$("#again").onclick=()=>{$("#formBox").hidden=false;$("#done").hidden=true};
</script>
</body></html>
